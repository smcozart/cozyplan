# Secrets
.env

# Heavy / scratch media (kept out of the repo)
*.pdf
*.mov

# Stray raster screenshots dropped at the repo root — but keep curated images
/*.jpg
/*.jpeg
/*.png

# Curated images that the README and example plans depend on stay tracked
!images/
!specs/

# Test cache — never versioned.
.pytest_cache/
__pycache__/

# Local test virtualenv — pytest is not installed on this machine.
.venv*/

# Queued work items awaiting `gh` (ADR-0001) — replayed, never versioned.
.scratch/

# Locally-installed Claude plugins/skills used while working in this repo
# (ponytail, mattpocock-skills, etc.). NOTE: do not ignore .claude/ wholesale —
# `init --vendor` tracks .claude/skills/ on purpose so clones install nothing.
.claude/plugins/
.claude/skills/ponytail*/
.claude/skills/mattpocock*/
skills/ponytail*/
skills/mattpocock*/
